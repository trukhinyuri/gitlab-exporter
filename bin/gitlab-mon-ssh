#!/usr/bin/env ruby

require "gitlab_monitor"

def main
  git = GitLab::Monitor::Git.new(File.expand_path("~/dev/emptyness"))
  metrics = GitLab::Monitor::PrometheusMetrics.new
  metrics.add "git_pull_time_milliseconds", (git.pull * 1000).to_i, repo: "emptyness"
  metrics.add "git_push_time_milliseconds", (git.push * 1000).to_i, repo: "emptyness"
  File.open(File.expand_path("~/metrics/git.prom"), "w") do |prom|
    prom.write(metrics.to_s)
  end
end

main() if __FILE__ == $0
